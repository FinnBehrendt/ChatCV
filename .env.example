# .env file (DO NOT SHARE THIS PUBLICLY)

# Preferred shared interface for local servers and hosted APIs.
# This example uses OpenAI's endpoint. Adding docker-compose.ollama.yml selects
# local chat automatically; choose its model with OLLAMA_CHAT_MODEL below.
# For local Pixi + Docker Ollama set LLM_BASE_URL=http://localhost:11434/v1,
# LLM_MODEL to the installed model tag and LLM_API_KEY to an empty value.
LLM_MODEL=gpt-4o-mini # Use an installed model tag, e.g. llama3.2:1b, for Ollama.
LLM_PROVIDER=openai_compatible
LLM_TEMPERATURE=0.1 # Set null to omit temperature for models that reject it.
LLM_TIMEOUT=60 # OpenAI / compatible chat request timeout in seconds.
LLM_BASE_URL=https://api.openai.com/v1
# Required for the hosted endpoint above; blank for unauthenticated local servers.
LLM_API_KEY=

# Chat and embedding providers are independent.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT=60 # OpenAI / compatible embedding request timeout in seconds.
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Embedding endpoint's own key, independent of the chat key.
EMBEDDING_API_KEY=

# Optional existing adapters: LLM_PROVIDER / EMBEDDING_PROVIDER can still be
# openai or ollama. The openai adapter uses OPENAI_API_KEY as its shared default.
# The preferred compatible path NEVER inherits this key; set both role keys above.
OPENAI_API_KEY=

# Only used by the native ollama adapter (not by openai_compatible).
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_TIMEOUT=120 # Timeout for Ollama chat and embedding requests.
# OLLAMA_MODELS is an Ollama server storage directory, NOT a model name.
# Optional: pin a specific Ollama Docker image using OLLAMA_IMAGE.
# The local Compose override uses this chat model instead of LLM_MODEL above.
OLLAMA_CHAT_MODEL=llama3.2:1b

# OPTIONAL: Advanced Analytics with Langsmith
# Set LANGSMITH_TRACING=true AND provide LANGSMITH_API_KEY to enable
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="ChatCV"

# OPTIONAL: Enhanced Content Safety with Guardrails AI
# If not provided, basic content validation will be used instead
GUARDRAILS_TOKEN=

# === INVITE CODES Configuration ===
INVITE_CODES={"test": {"company": "Test Company", "recruiter": "Test User", "active": true}, "demo": {"company": "Demo Corp", "recruiter": "Demo User", "active": true}}


# MLFlow Configuration
MLFLOW_TRACKING_URI=./mlruns
# MLFLOW_TRACKING_URI=https://your-mlflow-server.com  # For remote MLFlow server#

ENVIRONMENT=development  # Set to 'production' for production environment

# Logging Configuration
LOG_DIR=./logs
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
